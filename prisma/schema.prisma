generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Incident {
  id        String   @id @default(uuid())
  type      String
  date      DateTime
  address   String
  createdAt DateTime @default(now())
  source    String

  neighborId Int
  neighbor   Neighbor @relation(fields: [neighborId], references: [gid])
}

model Vote {
  id        String   @id @default(uuid())
  ip        String
  location  String
  createdAt DateTime @default(now())
}

model Neighbor {
  gid   Int    @id
  nro   Int
  name  String
  codba String

  incidents Incident[]
}
