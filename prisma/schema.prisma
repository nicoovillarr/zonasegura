generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Incident {
  id        String   @id @default(uuid())
  type      String
  date      DateTime
  hour      Int?
  neighbor  String
  address   String
  createdAt DateTime @default(now())
  source    String
}

model Vote {
  id        String   @id @default(uuid())
  ip        String
  location  String
  createdAt DateTime @default(now())
}
